# Vite inlines these at build time. Render supplies VITE_API_BASE from the
# blueprint, so this file exists to document the shape and to make a local
# production build behave like the deployed one.
#
# Must be https. The frontend is served over https, and a browser blocks
# http calls from an https page as mixed content, which takes out both fetch
# and the EventSource the live map depends on.
VITE_API_BASE=https://ekoalert-api.onrender.com/api/v1

# Tiles need no key here. Stadia authenticates deployed sites by domain, so
# registering the site in their dashboard is enough and no URL changes.
# Set these three only if you move to a different tile provider.
# VITE_TILE_URL_LIGHT=
# VITE_TILE_URL_DARK=
# VITE_TILE_ATTRIBUTION=
